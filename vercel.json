{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/generate-invoice-pdf.js": {
      "memory": 2048,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/scheduled-emails",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/monthly-billing",
      "schedule": "0 6 1 * *"
    }
  ]
}
